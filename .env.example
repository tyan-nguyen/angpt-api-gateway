PORT=3001
HOST=0.0.0.0
# Địa chỉ backend local LLM của bạn (vLLM, Ollama, LMDeploy)
LLM_BACKEND_URL=http://127.0.0.1:8000/v1
# Khóa bí mật dùng cho quyền Admin quản lý API Key
MASTER_ADMIN_KEY=admin-secret-local-ai
# Tên Model mặc định
DEFAULT_MODEL=qwen2.5-vl-7b-instruct
# Giới hạn tần suất gọi mặc định (requests/phút)
DEFAULT_RATE_LIMIT_RPM=60
